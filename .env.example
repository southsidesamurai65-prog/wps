# 复制为 .env 后按需填写。默认所有功能本地处理，外部 API 默认关闭。
# 隐私原则：不上传文档正文；API Key 只存本地；日志不记录敏感内容。

# PPT 美化外部 API（第三阶段）。留空 + ENABLE_API_UPLOAD=false 时，相关功能不可用。
PPT_BEAUTIFY_BASE_URL=https://api.example.com
PPT_BEAUTIFY_API_KEY=
# 是否允许上传到外部 API。默认关闭，所有功能本地处理。
ENABLE_API_UPLOAD=false

# 本地辅助 LLM（美化建议等可选增强能力用，与上面的美化外部 API 相互独立）。
# provider 可选：gemini | claude | openai
LLM_PROVIDER=gemini
LLM_API_KEY=

# 默认输出目录。留空则输出到源文件旁的 processed/ 目录。
DEFAULT_OUTPUT_DIR=

# 任务并发数。
TASK_MAX_WORKERS=2
