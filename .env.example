# 复制为 .env 后按需填写。默认所有功能本地处理，外部 API 默认关闭。
# 隐私原则：不上传文档正文；API Key 只存本地；日志不记录敏感内容。

# 是否允许把内容发出本机（PPT 美化会把每页「文本」发给 LLM）。
# 默认关闭，所有功能本地处理。设 true 才会构造美化客户端。
ENABLE_API_UPLOAD=false

# PPT 美化用的 LLM（本地解析 pptx → 文本 spec 发 LLM → 本地渲染重建 deck）。
# pptx 字节不出本机，只发每页文本。支持 openai / opencode-go（均 OpenAI 兼容）。
LLM_PROVIDER=opencode-go
LLM_API_KEY=
# 模型名按需配，避免写死过时模型。opencode-go 用 deepseek-v4.1-flash。
LLM_MODEL=deepseek-v4.1-flash
# 接入点。openai=官方；opencode-go=https://opencode.ai/zen/go；
# 换中转/Azure/自部署 OpenAI 兼容 endpoint 也在这。
LLM_BASE_URL=https://opencode.ai/zen/go
# 推理强度（low/high/max）；留空则不带该字段。opencode-go 的 ds v4.1 建议 high。
LLM_REASONING_EFFORT=high

# 默认输出目录。留空则输出到源文件旁的 processed/ 目录。
DEFAULT_OUTPUT_DIR=

# 任务并发数。
TASK_MAX_WORKERS=2
